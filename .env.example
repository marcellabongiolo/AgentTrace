# Optional bearer token for API ingestion/query routes.
# Leave blank for trusted local development.
AGENTTRACE_API_KEY=

# Python SDK export target.
AGENTTRACE_ENDPOINT=http://localhost:8000/api/v1/traces

# SQLite file used by the API.
AGENTTRACE_DATABASE=data/agenttrace.db

# Dashboard API base URL embedded into the browser build.
NEXT_PUBLIC_AGENTTRACE_API_URL=http://localhost:8000
